# Copy this file to .env.local and replace with your actual configuration values.
# Fork: GA4 is not used. Left empty on purpose: the upstream placeholder
# (G-XXXXXXXXXX) is truthy, so the app initialized Google Analytics with it.
REACT_APP_GOOGLE_ANALYTICS_ID=
REMOTE_HOST="your-website.com"
REMOTE_USER="username"
REMOTE_SERVER_DIR="chip-player-service"
REMOTE_STATIC_DIR="/var/www/your-website/public_html"
REMOTE_SSH_HOST="${REMOTE_USER}@${REMOTE_HOST}"
# Optional, for purging Cloudflare cache after deployment
# CLOUDFLARE_ZONE_ID=""
# CLOUDFLARE_API_TOKEN=""
